# Copy to .env.local and fill in. Everything is optional: without keys Tagih runs with a
# labelled PayPal simulator and a rule engine, so the demo always works.

# AI agent (OpenAI). Without it, the rule engine plans instead (labelled "rules" in the trace).
OPENAI_API_KEY=
# Any chat-completions model with tool calling. Default: gpt-5-mini
OPENAI_MODEL=

# PayPal sandbox app: developer.paypal.com > Apps & Credentials > Sandbox > Create App
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional. Defaults to https://api-m.sandbox.paypal.com
PAYPAL_API_BASE=
# Email of your sandbox Personal (buyer) account. Demo invoices go here so you can pay them.
# developer.paypal.com > Testing Tools > Sandbox Accounts
PAYPAL_DEMO_RECIPIENT=

# Optional
TAGIH_BUSINESS_NAME=Raka Studio
# Set to "off" on a public deployment if you do not want visitors to use Demo control
TAGIH_DEMO_CONTROLS=
